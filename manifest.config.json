{
  "manifest_version": 3,
  "name": "Hi.",
  "version": "1.0.4",
  "description": "Your favorite sites in place of the new tab page.",
  "permissions": ["favicon"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@hi.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
